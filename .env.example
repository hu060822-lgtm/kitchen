# 《NULL：最後一桌》伺服器環境變數（全部選填）

# 監聽埠（Render 會自動注入 PORT）
PORT=3001
NODE_ENV=production

# 前後端分開部署時才需要：允許的前端來源（逗號分隔）。同源部署（預設）不用設定。
# CORS_ORIGIN=https://your-frontend.example.com

# 班次長度（秒）：開店前的備料、營業
PREP_SECONDS=60
SERVICE_SECONDS=420
# 恐怖系統（客人、怪物）。0＝純料理模式
THREATS=1
# 房間上限與閒置自動關閉（分鐘）
MAX_ROOMS=200
ROOM_IDLE_MINUTES=15

# 開發者工具（查看怪物狀態、跳過備料、召喚客人與怪物、直接打烊）。正式環境（NODE_ENV=production）預設關閉；
# 設為 1 強制開啟、0 強制關閉。不要在公開的正式服務開啟。
# DEBUG_TOOLS=0

# 前端靜態檔位置（預設會自動找 ../client/dist 或 ./client/dist）
# CLIENT_DIST=/opt/render/project/src/client/dist

# WebRTC ICE 伺服器。STUN 預設使用 Google 公用 STUN。
# 強烈建議正式上線時設定 TURN（對稱型 NAT、公司／學校網路下沒有 TURN 語音可能連不上）。
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=

# 缺陷卡的效果數值（JSON，只寫要覆寫的欄位；格式錯誤會用預設值）。完整欄位見 shared/src/flaws.ts 的 DEFAULT_FLAW_CONFIG
# FLAW_CONFIG={"D02":{"maxStrokeCut":3},"D15":{"capacity":3}}
